<%- include('../includes/head.ejs') %>
  <link rel="stylesheet" href="/css/product.css">
  </head>

  <body>
    <%- include('../includes/navigation.ejs') %>
      <main id="main-content">
        <div class="page-header">
          <div>
            <span class="eyebrow">The collection</span>
            <h1>Shop all products</h1>
            <p>Quality pieces, honest pricing, and the essentials worth keeping close.</p>
          </div>
        </div>
        <% if (prods.length> 0) { %>
          <div class="grid">
            <% for (let product of prods) { %>
              <article class="card product-item">
                <a class="card__image" href="/products/<%= product._id %>" aria-label="View <%= product.title %>">
                  <img src="<%= productImageUrl(product.mainImageUrl) %>" alt="<%= product.title %>" loading="lazy">
                </a>
                <div class="card__content">
                  <h2 class="product__title" dir="auto">
                    <%= product.title %>
                  </h2>
                  <p class="product__price">$<%= Number(product.price).toFixed(2) %>
                  </p>
                  <p class="product__description" dir="auto">
                    <%= product.description %>
                  </p>
                </div>
                <div class="card__actions">
                  <a href="/products/<%= product._id %>" class="btn secondary">Details</a>
                  <%- include('../includes/add-to-cart.ejs', {product: product}) %>
                </div>
              </article>
              <% } %>
          </div>
          <%- include('../includes/pagination.ejs', {currentPage, nextPage, previousPage, lastPage, hasNextPage,
            hasPreviousPage}) %>
            <% } else { %>
              <section class="empty-state">
                <div class="empty-state__icon" aria-hidden="true">N</div>
                <h1>No products available yet</h1>
                <p>The collection is being refreshed. Please check back soon.</p>
                <div class="empty-state__actions"><a class="btn" href="/">Return home</a></div>
              </section>
              <% } %>
      </main>
      <%- include('../includes/end.ejs') %>