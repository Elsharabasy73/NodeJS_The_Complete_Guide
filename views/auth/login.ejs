<%- include('../includes/head.ejs') %>
  <link rel="stylesheet" href="/css/forms.css">
  <link rel="stylesheet" href="/css/auth.css">
  </head>

  <body>
    <%- include('../includes/navigation.ejs') %>
      <main id="main-content">
        <section class="auth-shell">
          <div class="auth-shell__intro"><span class="eyebrow">Welcome back</span>
            <h1>Good to see you again.</h1>
            <p>Sign in to manage your cart, track orders, and continue discovering the collection.</p>
          </div>
          <div class="auth-shell__form">
            <h2>Login</h2>
            <p>Enter your details to access your account.</p>
            <% if (errorMessage) { %>
              <div class="user-message user-message--error" role="alert">
                <%= errorMessage %>
              </div>
              <% } %>
                <form class="login-form" action="/login" method="POST">
                  <div class="form-control"><label for="email">Email address</label><input
                      class="<%= validationErrors.find(e => e.path === 'email') ? 'invalid' : '' %>" type="email"
                      name="email" value="<%= oldInput.email %>" id="email" autocomplete="email" required></div>
                  <div class="form-control"><label for="password">Password</label><input
                      class="<%= validationErrors.find(e => e.path === 'password') ? 'invalid' : '' %>" type="password"
                      name="password" id="password" autocomplete="current-password" required></div>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn" type="submit">Login securely</button>
                </form>
                <p class="auth-footer"><a href="/reset">Forgot your password?</a></p>
                <p class="auth-footer">New to Northstar? <a href="/signup">Create an account</a></p>
          </div>
        </section>
      </main>
      <%- include('../includes/end.ejs') %>